# Build products of `setup.py build_ext --inplace`, which is how this package is
# built and how ROS-Scanning's host-side EC tests find it when it is not
# installed. All interpreter-specific; none of it belongs in the repository.
build/
*.egg-info/
__pycache__/
*.pyc
# Generated by cythonize from ec_condition.pyx.
spatialnde2_ec_functions/ec_condition.cpp
# The extension itself: ~4.5 MB, ABI-tagged, rebuilt in a minute.
*.so
